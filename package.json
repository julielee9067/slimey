{
  "name": "slimey",
  "productName": "Slimey",
  "version": "0.1.0",
  "description": "PR 리뷰 요청을 삼키고 Claude Code 를 지켜보는 데스크톱 슬라임",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node src/agents.js && node src/pr.js && node src/usage.js",
    "build": "electron-packager . Slimey --platform=darwin --arch=arm64 --out=dist --overwrite",
    "icon": "python3 scripts/tray-icon.py",
    "shots": "electron scripts/shots.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0"
  }
}
